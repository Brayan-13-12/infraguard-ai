# ---------------------------------------------------------------------------
# InfraGuard AI - example environment configuration
#
# Copy this file to `.env` at the REPOSITORY ROOT before running Docker Compose
# or the backend on the host:
#     cp .env.example .env
#
# The backend resolves this file by absolute path (repo root, then backend/.env),
# so `cd backend && uvicorn ...` and running from the root behave identically.
# Explicit environment variables always override values in `.env`.
#
# This file contains ONLY safe local-development placeholders.
# NEVER put real secrets, production credentials or tokens in this file.
# The real `.env` file is git-ignored.
# ---------------------------------------------------------------------------

# --- Runtime environment: development | production | test ---
ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_DB=infraguard
POSTGRES_USER=infraguard
POSTGRES_PASSWORD=change_me_for_local_development

# Hostname used by the backend to reach the database.
# Inside Docker Compose this is the service name: `db`.
# For running the backend directly on the host, use `localhost`.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full SQLAlchemy database URL (psycopg v3 driver).
# If left unset, the backend assembles it from the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://infraguard:change_me_for_local_development@db:5432/infraguard

# --- Backend API ---
# Comma-separated list of allowed CORS origins (the local frontend only).
# A wildcard ("*") is rejected when ENVIRONMENT=production.
# Credentials (the auth cookie) are enabled, so this must never be "*".
BACKEND_CORS_ORIGINS=http://localhost:3000

# Seconds before the readiness DB check times out (0 < value <= 30).
DB_HEALTHCHECK_TIMEOUT=3

# --- Authentication (v0.2) ---
# HS256 signing secret for JWT access tokens. This local placeholder is REJECTED
# when ENVIRONMENT=production (must be >= 32 chars and not a known default).
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-jwt-secret-change-me

# Interactive session lifetime in minutes. Drives BOTH the JWT `exp` and the
# auth cookie `Max-Age` (one source). No refresh tokens / server-side revocation
# yet, so this is also the max validity window of a leaked token.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Auth cookie `Secure` flag. Unset -> derived from ENVIRONMENT (Secure only in
# production). Uncomment to override:
# AUTH_COOKIE_SECURE=true

# Cookie SameSite policy: lax (default) | strict | none.
AUTH_COOKIE_SAMESITE=lax

# --- Bootstrap Administrator (Governance Phase 3) ---
# Public registration only ever creates a PENDING access request - it can never
# grant a role or an active account. The first Administrator is created by an
# explicit, idempotent command that reads the two variables below:
#
#     docker compose run --rm bootstrap          # inside Docker Compose
#     python -m app.scripts.bootstrap_admin      # on the host
#
# It creates the account only if the email is absent; if it already exists it is
# activated + promoted to Administrator WITHOUT touching the password. Set your
# own local values in `.env` - do NOT commit a real password here. The password
# must satisfy the app policy (>= 12 characters); the placeholder below is
# deliberately too short so the command fails loudly until you change it.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- Frontend ---
# Base URL of the backend API, as reached from the user's browser.
# Must NOT contain secrets: anything prefixed NEXT_PUBLIC_ is exposed to the client.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# PRODUCTION expectations (not used for local dev)
# ---------------------------------------------------------------------------
# When ENVIRONMENT=production the backend refuses to start unless:
#   * the database password is NOT a well-known placeholder/default, and
#   * the database password is at least 12 characters, and
#   * BACKEND_CORS_ORIGINS contains explicit origins (no "*").
#
# In production, inject these values as real environment variables - never via a
# committed file. A dedicated deployment phase will source them from Kubernetes
# Secrets / an external secret manager (e.g. Vault, cloud secret managers).
# v0.1 intentionally does not integrate a secret manager.
