# ---------------------------------------------------------------------------
# InfraGuard AI - root .gitignore
# ---------------------------------------------------------------------------

# --- Environment files (keep .env.example tracked) ---
.env
.env.*
!.env.example
*.env
!*.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
.venv*/
venv/
env/
ENV/
.python-version

# --- Python tooling / test artifacts ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
*.cover

# --- Node / Next.js ---
node_modules/
.pnp
.pnp.js
.next/
out/
build/
.turbo/
*.tsbuildinfo
# Auto-generated by `next dev` / `next build`; not source.
next-env.d.ts

# --- Test coverage ---
/coverage/
**/coverage/
.vitest/

# --- Package manager logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Logs & temp ---
logs/
*.log
tmp/
temp/
*.tmp

# --- IDE / Editor ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Windows PowerShell generated artifacts (not project source) ---
Microsoft/
**/PowerShell/ModuleAnalysisCache

# --- Docker ---
*.pid

# --- Local database data (if ever bind-mounted) ---
pgdata/
